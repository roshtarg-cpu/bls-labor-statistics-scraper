{
  "actorSpecification": 1,
  "name": "bls-labor-statistics-scraper",
  "title": "BLS Labor Statistics Scraper \u2014 CPI, Jobs & Wages",
  "description": "Scrapes Bureau of Labor Statistics data: CPI, employment, wages, and unemployment series. Returns structured JSON for economists, analysts, and AI agents. Works with Claude, ChatGPT, and AI agents via Apify MCP.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "properties": {
      "seriesId": {
        "type": "string",
        "description": "BLS series ID",
        "template": "{{{seriesId}}}"
      },
      "year": {
        "type": "string",
        "description": "Year of data point",
        "template": "{{{year}}}"
      },
      "period": {
        "type": "string",
        "description": "Month period code",
        "template": "{{{period}}}"
      },
      "periodName": {
        "type": "string",
        "description": "Month name",
        "template": "{{{periodName}}}"
      },
      "value": {
        "type": "string",
        "description": "Data value",
        "template": "{{{value}}}"
      },
      "seriesTitle": {
        "type": "string",
        "description": "Human readable series title",
        "template": "{{{seriesTitle}}}"
      },
      "scrapedAt": {
        "type": "string",
        "description": "Timestamp of scrape",
        "template": "{{{scrapedAt}}}"
      }
    }
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Results",
          "transformation": {
            "fields": [
              "seriesId",
              "seriesTitle",
              "year",
              "period",
              "periodName",
              "value",
              "latest",
              "footnotes",
              "scrapedAt"
            ]
          }
        }
      }
    }
  }
}